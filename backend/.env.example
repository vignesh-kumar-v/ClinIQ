QWEN_API_KEY=your_key_here

# Override for Ollama local testing: http://localhost:11434/v1
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Model names — swap for Ollama model names when testing locally
CHAT_MODEL=qwen-max
INTENT_MODEL=qwen-plus

# ChromaDB path relative to backend/
CHROMA_PATH=../chroma_db

# sentence_transformers model — must match ingest_chromadb.py (Qwen3-Embedding-0.6B, 1024-dim)
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_BATCH_SIZE=64

# Retrieval tuning
TOP_K_SYNTHEA=5
TOP_K_MTSAMPLES=3
MAX_HISTORY_TURNS=10
EMBED_BATCH_SIZE=25
